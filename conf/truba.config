// TRUBA (ARF): SLURM executor, Apptainer containers and the resources of every
// label (-profile truba). The rules of the cluster:
//   * jobs are submitted from /arf/scratch (the work directory is there);
//   * every job runs on one node (--nodes=1); nodes that fail or slow jobs are
//     excluded (--exclude_nodes; 2026-10: barbun45, barbun46 and barbun106 fail Apptainer,
//     barbun118 aborted PopPUNK, barbun89 ran the pilot's units 2-4 times slower,
//     hamsi20 and hamsi29 end jobs within a second without an exit status; 2026-11-01: barbun67
//     failed Apptainer with exit 255 for all 57 failures in the first 15 minutes of a run, the
//     node freeing up at once and drawing the next job). A name that is no
//     longer in the cluster makes SLURM refuse the whole submission ("Invalid node name
//     specified"), and the list travels with every task, so one dead name stops the run: orfoz359
//     was dropped from the cluster and taken out of the list on 2026-10-26.
//   * job and file names may not contain spaces, brackets, quotes, ',', '=', '$',
//     Turkish letters and similar characters;
//   * barbun: 40 cores and 384 GB per node, at least 20 cores per job, at most
//     9.5 GB per core, at most 3 days; hamsi: 56 cores, about 3.3 GB per core;
//     orfoz: 112 cores, 2.17 GB per core; debug: 4 hours, 2.17 GB per core;
//   * at most 100 submitted jobs per user. The head jobs count against that limit too, and
//     several may be queued at once (one per partition, conf/truba_head.sbatch), so queueSize
//     leaves room for them: with 95 the run was refused mid-flight and ended, because SLURM
//     counts the pending heads as well ("Job violates accounting/QOS policy", printed with a
//     misleading barbun message, 2026-10-22). The long steps send
//     at most maxForks jobs each, so that whole-node jobs waiting for hamsi do not take every
//     place of the queue from the short steps (2026-10-09: 90 waiting RGI and AMRFinderPlus
//     jobs kept the matrices from debug);
//   * compute nodes have no internet: the DOWNLOAD and CONTEXT entries run their
//     tasks on the login node (label internet, local executor).
// The head job runs on the login node (every partition allows at most 3 days), whose
// processes may use 300 s of CPU (360 s hard; 2026-10-08): a lean JVM, the soft limit
// raised to the hard one and its CPU time watched. Near the limit it is stopped with
// SIGKILL (its jobs keep running), the pending jobs are cancelled and, once the running
// ones have ended, it is launched again with -resume; --reuse_units keeps what they finished:
//   ulimit -St 360; export NXF_OPTS='-Xms1g -Xmx4g -XX:+UseSerialGC -XX:-UsePerfData'
//   setsid nohup nextflow run main.nf -profile truba --organisms ecoli,kpneumoniae \
//       --reuse_units -ansi-log false [-resume] > run.out 2>&1 < /dev/null &

params {
    queue          = 'barbun'
    queue_light    = null       // partition of the short steps (label light); null: queue
    queue_large    = null       // partition of the heavy steps of large_organisms; null: queue
    large_organisms = ''        // e.g. ecoli,kpneumoniae (see heavyQueue)
    queue_short    = null       // partition of the minutes-long steps (see shortQueue); null: as heavy
    exclude_nodes  = 'barbun45,barbun46,barbun67,barbun78,barbun89,barbun106,barbun118,hamsi20,hamsi29'  // see the rules above
    // nodes found faulty during a run, one per line, added to exclude_nodes (see excludeNodes)
    exclude_nodes_file = "/arf/scratch/${System.getenv('USER')}/amr/exclude_nodes.txt"
    containers_dir = "/arf/scratch/${System.getenv('USER')}/amr/containers"
    container_amr     = "${params.containers_dir}/amr.sif"           // analysis (and RGI, F6.1)
    container_tools   = "${params.containers_dir}/amr-tools.sif"     // QUAST, AMRFinderPlus, ResFinder
    container_pyseer  = "${params.containers_dir}/amr-pyseer.sif"    // pyseer (Python 3.8)
    container_checkm2 = "${params.containers_dir}/amr-checkm2.sif"
    // the reference databases, downloaded on one day and recorded with scripts/databases.py
    databases_dir     = "${projectDir}/data/external"
    amrfinder_db      = "${params.databases_dir}/amrfinderplus/latest"
    resfinder_db      = "${params.databases_dir}/resfinder_db"
    pointfinder_db    = "${params.databases_dir}/pointfinder_db"
    checkm2_db        = "${params.databases_dir}/checkm2/CheckM2_database/uniref100.KO.1.dmnd"
    // cores and memory per core (MaxMemPerCPU, MiB) of every partition, the fewest
    // cores a job may ask for, the longest time, and the multiple the cores must be
    // (TRUBA, 2026-10: hamsi jobs take whole 56-core nodes, orfoz jobs 56 or 112 cores).
    // barbun takes 20 or 40 cores and nothing between: with --nodes=1, sbatch --test-only
    // accepted -c 20 and -c 40 and refused -c 38 ("node basina 20 cekirdek", 2026-11-01).
    // With step 1 the retry of a 180 GiB job asked 38 cores (361,000 MB), was refused at
    // submission, and a refused submission ends the run: it stopped at 2,905 of 3,450
    // permutation chunks.
    partitions = [
        barbun: [cpus: 40, min_cpus: 20, mb_per_cpu: 9500, max_hours: 72, step: 20],
        hamsi : [cpus: 56, min_cpus: 56, mb_per_cpu: 3300, max_hours: 72, step: 56],
        orfoz : [cpus: 112, min_cpus: 56, mb_per_cpu: 2170, max_hours: 72, step: 56],
        debug : [cpus: 40, min_cpus: 1, mb_per_cpu: 2170, max_hours: 4, step: 1],
    ]
}

workDir = "/arf/scratch/${System.getenv('USER')}/amr/nf-work"

executor {
    name              = 'slurm'
    // TRUBA rejects job names with spaces, brackets, ':' and similar characters
    jobName           = { "kanit_${task.process.tokenize(':')[-1]}_" +
                          "${(task.tag ?: task.index).toString().replaceAll(/[^A-Za-z0-9_.-]+/, '_')}".take(80) }
    queueSize         = 88
    submitRateLimit   = '10/1min'
    pollInterval      = '1 min'
    queueStatInterval = '5 min'
}

apptainer {
    enabled    = true
    autoMounts = true
    runOptions = '--no-home -B /arf'
}

env {
    APPTAINER_BINDPATH        = '/arf'
    AMRFINDER_DB              = params.amrfinder_db
    CGE_RESFINDER_RESGENE_DB  = params.resfinder_db
    CGE_RESFINDER_RESPOINT_DB = params.pointfinder_db
    CHECKM2DB                 = params.checkm2_db
    // Python writes its output as it goes, so that the logs of a running job show its
    // progress (the units of a packed job wrote nothing until they ended)
    PYTHONUNBUFFERED          = '1'
}

// memory of one attempt in MiB: the label's GiB, doubled on every retry after an
// out-of-memory or killed job, never above what one node of the partition gives
def memoryFor(gib, attempt, queue = params.queue) {
    def p = params.partitions[queue]
    def cap = Math.floor(p.cpus * p.mb_per_cpu * 0.95) as long
    Math.min((gib * 1024 * Math.pow(2, attempt - 1)) as long, cap)
}

// time limit: the label's hours, never above the partition's limit
def timeFor(hours, queue = params.queue) {
    Math.min(hours, params.partitions[queue].max_hours)
}

// the partition of the short steps: --queue_light (e.g. debug, whose jobs start sooner),
// else --queue
def lightQueue() {
    params.queue_light ?: params.queue
}

// the partition of a heavy step (store, matrix, outer folds, permutations, CPSS, MDA) of one
// organism: --queue_large for the organisms of --large_organisms, else --queue. Two outer
// folds of E. coli or K. pneumoniae fill a job's 180 GiB, which barbun gives with 20 cores
// and hamsi only with a whole 56-core node.
def heavyQueue(org) {
    params.queue_large && (org in params.large_organisms.toString().tokenize(',')) ?
        params.queue_large : params.queue
}

// the hours of a heavy step: half as many again for the organisms of --large_organisms, whose
// units run for a day where the pilot's took hours (E. coli ampicillin, 4,645 genomes × 4.2 M
// patterns: 16-23 hours per job, 2026-10-10..14). A job must ask for much less than the partition's
// limit, or the scheduler cannot fit it into the gaps it keeps for higher-priority jobs: with
// 36 hours (barbun's limit is 72) the queue moved again while 36 nodes stood idle (2026-10-15).
def heavyHours(org, hours) {
    params.queue_large && (org in params.large_organisms.toString().tokenize(',')) ? (3 * hours).intdiv(2) : hours
}

// the partition of the steps that take minutes but much memory (matrix, CPSS, MDA, pyseer):
// --queue_short (e.g. debug, at most 4 hours, whose jobs start sooner than a whole hamsi
// node), else that of a heavy step
def shortQueue(org) {
    params.queue_short ?: heavyQueue(org)
}

// the nodes a job must not run on: --exclude_nodes and the names in --exclude_nodes_file, read
// at every submission, so that a node that breaks during a run takes no further job without a
// restart (a queued job cannot be changed: TRUBA refuses scontrol update, 2026-11-11). The file
// is written by recordNodeFault; a line that is not a node name is skipped, since an unknown
// name makes SLURM refuse the submission
def excludeNodes() {
    def names = (params.exclude_nodes ?: '').toString().tokenize(',')
    def f = params.exclude_nodes_file ? new File(params.exclude_nodes_file.toString()) : null
    if (f?.isFile()) {
        names += f.readLines()*.trim().findAll { it ==~ /[a-z]+[0-9]+/ }
    }
    names.unique()
}

// shell run on the node after a task (afterScript): when Apptainer could not start because the
// node does not know the user, the node is written into --exclude_nodes_file, so that the retry
// and every later job go elsewhere. On 2026-11-11 barbun16, barbun35 and barbun73 failed this way
// in turn; the node, whose jobs end within seconds, is the one left free, and the four waiting
// whole-node CABBAGE jobs failed on it together three times.
def recordNodeFault() {
    params.exclude_nodes_file ?
        'if [[ ${nxf_main_ret:-0} != 0 ]] && grep -q "determine user account information" .command.err 2>/dev/null; ' +
        'then echo "${SLURMD_NODENAME:-$(hostname -s)}" >> ' + "'${params.exclude_nodes_file}'; fi" : ''
}

// cores of one attempt: enough for its memory (MiB) at the partition's MaxMemPerCPU
def cpusFor(mb, wanted, queue = params.queue) {
    def p = params.partitions[queue]
    int n = Math.max(p.min_cpus, Math.max(wanted, Math.ceil(mb / p.mb_per_cpu) as int))
    Math.min(p.cpus, ((n + p.step - 1).intdiv(p.step) * p.step) as int)
}

process {
    executor       = 'slurm'
    queue          = { params.queue }
    clusterOptions = { def n = excludeNodes(); "--nodes=1" + (n ? " --exclude=${n.join(',')}" : '') }
    afterScript    = { recordNodeFault() }
    container      = params.container_amr
    // retried, with the next attempt's resources: 127 and 255 (the container did not start),
    // 137 (killed, memory), 140 (over the
    // time or memory limit). 127 was added on 2026-10-27: the same node fault that gives 255
    // ("Couldn't determine user account information: unknown userid") can leave the task with
    // 127 instead, and 127 was not retried, so a single bad node ended the run twice — the
    // second time after 11 h, with 10 of the failures on barbun78. The exit code of a node
    // fault is not stable; treat both as the container not starting. Apptainer fails on some nodes
    // with "Couldn't determine user account information", and the job ends in seconds;
    // barbun106, 2026-10-14) and a job the system removed without an exit status
    // (Integer.MAX_VALUE; e.g. a node failure: job 6443221 was cancelled by root on
    // hamsi20 one second after it started, 2026-10-04). Any other error ends the run after the
    // running jobs have finished ('finish'), so that one failing task does not cancel days of
    // running jobs ('terminate' cancelled 35, among them CV jobs of 20 hours, 2026-10-12)
    // A node fault (127, 255, no exit status) is retried up to six times, since the faulty node is
    // excluded from the retry (recordNodeFault); memory and time up to three times.
    errorStrategy  = { def fault = task.exitStatus in [127, 255] || task.exitStatus == Integer.MAX_VALUE;
                       (fault && task.attempt <= 6) || (task.exitStatus in [137, 140] && task.attempt <= 3) ?
                           'retry' : 'finish' }
    maxRetries     = 6

    withLabel: light {
        queue  = { lightQueue() }
        memory = { memoryFor(16, task.attempt, lightQueue()).MB }
        cpus   = { cpusFor(memoryFor(16, task.attempt, lightQueue()), 1, lightQueue()) }
        time   = { timeFor(1 << (task.attempt - 1), lightQueue()).h }
    }
    withLabel: lineage {
        memory = { memoryFor(128, task.attempt).MB }
        cpus   = { cpusFor(memoryFor(128, task.attempt), 40) }
        time   = { timeFor(4).h }                      // en uzunu 6 dk
    }
    withLabel: store {
        queue  = { heavyQueue(org) }
        memory = { memoryFor(300, task.attempt, heavyQueue(org)).MB }
        cpus   = { cpusFor(memoryFor(300, task.attempt, heavyQueue(org)), 40, heavyQueue(org)) }
        time   = { timeFor(10, heavyQueue(org)).h }    // en uzunu 4,0 sa
    }
    withLabel: matrix {
        queue  = { shortQueue(meta.organism) }
        memory = { memoryFor(64, task.attempt, shortQueue(meta.organism)).MB }
        cpus   = { cpusFor(memoryFor(64, task.attempt, shortQueue(meta.organism)), 1,
                           shortQueue(meta.organism)) }
        time   = { timeFor(3, shortQueue(meta.organism)).h }   // en uzunu 13 dk
    }
    // time limits: measured on the run itself (sacct over 1,400 finished jobs, 2026-10-20),
    // about one and a half times the longest task seen, doubled on every retry after a
    // time-out. The first limits came from the pilot and were far too generous: RGI asked
    // 48 h and took 6.6, CheckM2 asked 72 h and took 3.8, QUAST asked 48 h and took 23
    // minutes. TRUBA plans the queue from --time (TRUBA documentation on queue scheduling), so
    // a job that asks for much more than it needs is kept out of the gaps the scheduler
    // fills, and a low-priority account then waits with nodes idle. Permutation chunks had
    // the opposite fault: 9 h asked, 10.3 h needed, which is the exit 140 of the K.
    // pneumoniae meropenem batches (2026-10-18).
    // the outer folds or permutation chunks of one model that share a job (lib/packing.py;
    // config.yaml packing.budget_gb); 180 GiB fits barbun's 20 cores (9,500 MB per core)
    // (E. coli, every genome: 76 GiB in the process, 104 GiB by sacct, 2026-10-02)
    // 40 at once: with 25, none waited on barbun while about 380 of 409 jobs of 8 to 23 hours
    // remained (2026-10-11)
    // Unitig–k-mer comparison (scripts/m3_budget.py): one model's χ² in every training set; arm C reads
    // the organism's whole k-mer store (E. coli tens of GiB). Not measured yet: generous.
    withLabel: m3_budget {
        queue  = { heavyQueue(meta.organism) }
        memory = { memoryFor(64, task.attempt, heavyQueue(meta.organism)).MB }
        cpus   = { cpusFor(memoryFor(64, task.attempt, heavyQueue(meta.organism)), 20,
                           heavyQueue(meta.organism)) }
        time   = { timeFor(12 << (task.attempt - 1), heavyQueue(meta.organism)).h }
    }
    withLabel: cv_unit {
        maxForks = 40
        queue  = { heavyQueue(meta.organism) }
        memory = { memoryFor(180, task.attempt, heavyQueue(meta.organism)).MB }
        cpus   = { cpusFor(memoryFor(180, task.attempt, heavyQueue(meta.organism)), 20,
                           heavyQueue(meta.organism)) }
        time   = { timeFor(heavyHours(meta.organism, 24) << (task.attempt - 1),
                           heavyQueue(meta.organism)).h }
    }
    // 40, as cv_unit: the same 180 GiB on 20 cores, and 25 of those never waited on barbun.
    // 10 left 77 of the 88 queue slots idle with 1,811 of the 3,450 chunks still to run
    // (2026-10-27)
    withLabel: permutation {
        maxForks = 40
        queue  = { heavyQueue(meta.organism) }
        memory = { memoryFor(180, task.attempt, heavyQueue(meta.organism)).MB }
        cpus   = { cpusFor(memoryFor(180, task.attempt, heavyQueue(meta.organism)), 20,
                           heavyQueue(meta.organism)) }
        time   = { timeFor(heavyHours(meta.organism, 9) << (task.attempt - 1),
                           heavyQueue(meta.organism)).h }   // the longest took 10.3 h (the 6 h base was exceeded)
    }
    withLabel: cpss {
        queue  = { shortQueue(meta.organism) }
        memory = { memoryFor(32, task.attempt, shortQueue(meta.organism)).MB }
        cpus   = { cpusFor(memoryFor(32, task.attempt, shortQueue(meta.organism)), 20,
                           shortQueue(meta.organism)) }
        time   = { timeFor(4 << (task.attempt - 1), shortQueue(meta.organism)).h }
    }
    withLabel: mda {
        queue  = { shortQueue(meta.organism) }
        memory = { memoryFor(48, task.attempt, shortQueue(meta.organism)).MB }
        cpus   = { cpusFor(memoryFor(48, task.attempt, shortQueue(meta.organism)), 1,
                           shortQueue(meta.organism)) }
        time   = { timeFor(2 << (task.attempt - 1), shortQueue(meta.organism)).h }   // en uzunu 20 dk
    }
    withLabel: cabbage {             // external validation: poppunk_assign, unitig calls, predictions
        memory = { memoryFor(64, task.attempt).MB }
        cpus   = { cpusFor(memoryFor(64, task.attempt), 20) }
        time   = { timeFor(8).h }
    }
    withLabel: rgi {
        maxForks = 8
        memory = { memoryFor(64, task.attempt).MB }
        cpus   = { cpusFor(memoryFor(64, task.attempt), 20) }
        time   = { timeFor(14).h }                     // en uzunu 6,6 sa
    }
    withLabel: tools {
        maxForks = 8
        container = params.container_tools
        memory    = { memoryFor(64, task.attempt).MB }
        cpus      = { cpusFor(memoryFor(64, task.attempt), 20) }
        time      = { timeFor(8).h }                   // en uzunu 3,0 sa (EXTERNAL_RUN), QUAST 23 dk
    }
    withLabel: pyseer {
        container = params.container_pyseer
        queue     = { shortQueue(meta.organism) }
        memory    = { memoryFor(64, task.attempt, shortQueue(meta.organism)).MB }
        cpus      = { cpusFor(memoryFor(64, task.attempt, shortQueue(meta.organism)), 20,
                              shortQueue(meta.organism)) }
        time      = { timeFor(6, shortQueue(meta.organism)).h }   // en uzunu 99 sn
    }
    withLabel: checkm2 {
        container = params.container_checkm2
        memory    = { memoryFor(200, task.attempt).MB }
        cpus      = { cpusFor(memoryFor(200, task.attempt), 40) }
        time      = { timeFor(10).h }                  // en uzunu 3,8 sa
    }
    withLabel: kb {
        memory = { memoryFor(64, task.attempt).MB }
        cpus   = { cpusFor(memoryFor(64, task.attempt), 1) }
        time   = { timeFor(6).h }
    }
    withLabel: outputs {
        // the checksums of the outputs; the first run reads every file
        memory = { memoryFor(16, task.attempt).MB }
        cpus   = { cpusFor(memoryFor(16, task.attempt), 20) }
        time   = { timeFor(4).h }
    }
    withLabel: backup {
        // tar and pigz of the changed units of the results tree
        memory = { memoryFor(16, task.attempt).MB }
        cpus   = { cpusFor(memoryFor(16, task.attempt), 20) }
        time   = { timeFor(6).h }
    }
    withLabel: host {
        // rclone and sacct live on the login node, not in the containers
        executor  = 'local'
        container = ''
        cpus      = 1
        memory    = 4.GB
        time      = 72.h
    }
    withLabel: internet {
        executor = 'local'               // on the login node, whatever the partition
        cpus     = 1
        memory   = 8.GB
        time     = 72.h
    }
    withName: '.*CONTEXT_QUERY' {
        time     = 7.d                   // NCBI takes large BLAST jobs only at night and on weekends
    }
}
